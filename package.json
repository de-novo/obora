{
  "name": "obora",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Obora monorepo — AI Control Runtime packages, CLI, SDK, adapters, and dashboard",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "pnpm -r test",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "test:e2e:watch": "vitest --config vitest.config.e2e.ts",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "coverage:report": "node scripts/coverage/report.mjs",
    "verify:coverage": "node scripts/coverage/report.mjs --thresholds=scripts/coverage/thresholds.json",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "clean": "turbo clean && rm -rf node_modules",
    "verify:clean": "LC_ALL=C LANG=C LC_CTYPE=C bash scripts/verify-clean.sh",
    "verify:release": "LC_ALL=C LANG=C LC_CTYPE=C bash scripts/release/verify-release.sh",
    "verify:smoke": "node scripts/release/verify-operational-smoke.mjs",
    "verify:compat": "LC_ALL=C LANG=C LC_CTYPE=C bash scripts/release/verify-compat-inventory.sh",
    "verify:deps": "node scripts/release/verify-dependency-policy.mjs",
    "verify:functional": "node scripts/release/verify-functional-policy.mjs",
    "verify:functional:update": "node scripts/release/verify-functional-policy.mjs --update",
    "verify:test-type-debt": "LC_ALL=C LANG=C LC_CTYPE=C bash scripts/release/verify-test-type-debt.sh",
    "verify:sdk-public-api": "node scripts/release/verify-sdk-no-console.mjs && node scripts/release/verify-sdk-public-api.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/de-novo/obora.git"
  },
  "bugs": {
    "url": "https://github.com/de-novo/obora/issues"
  },
  "homepage": "https://github.com/de-novo/obora#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "pnpm": {
    "overrides": {
      "ajv@<6.14.0": "6.14.0",
      "brace-expansion@<1.1.13": "1.1.13",
      "esbuild@0.21.5": "0.25.0",
      "fast-uri@<=3.1.1": "3.1.2",
      "fast-xml-builder@<=1.1.6": "1.2.0",
      "flatted@<3.4.2": "3.4.2",
      "minimatch@<3.1.4": "3.1.4",
      "picomatch@<4.0.4": "4.0.4",
      "rollup@<4.59.0": "4.59.0",
      "vite@5.4.21": "6.4.2"
    }
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  }
}
