{
  "name": "obora",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Obora monorepo — AI Control Runtime packages, CLI, SDK, adapters, and dashboard",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "pnpm -r test",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "test:e2e:watch": "vitest --config vitest.config.e2e.ts",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "clean": "turbo clean && rm -rf node_modules",
    "verify:clean": "bash scripts/verify-clean.sh",
    "verify:release": "bash scripts/release/verify-release.sh",
    "verify:compat": "bash scripts/release/verify-compat-inventory.sh",
    "verify:test-type-debt": "bash scripts/release/verify-test-type-debt.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/de-novo/obora.git"
  },
  "bugs": {
    "url": "https://github.com/de-novo/obora/issues"
  },
  "homepage": "https://github.com/de-novo/obora#readme",
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@playwright/test": "^1.57.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^15.14.0",
    "prettier": "^3.7.4",
    "tsup": "^8.5.1",
    "turbo": "^2.7.4",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "overrides": {
      "ajv@<6.14.0": "6.14.0",
      "brace-expansion@<1.1.13": "1.1.13",
      "esbuild@0.21.5": "0.25.0",
      "flatted@<3.4.2": "3.4.2",
      "minimatch@<3.1.4": "3.1.4",
      "picomatch@<4.0.4": "4.0.4",
      "rollup@<4.59.0": "4.59.0",
      "vite@5.4.21": "6.4.2"
    }
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  }
}
