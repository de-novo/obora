{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [
    ".env"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "env": [
        "ZAI_API_KEY",
        "OBORA_TEST_MODEL",
        "OBORA_TEST_PROVIDER",
        "OBORA_TEST_BASE_URL"
      ]
    },
    "format": {
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
