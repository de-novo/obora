{
  "$schema": "../../preset.schema.json",
  "name": "resend",
  "category": "email",
  "description": "Resend - Developer-friendly email API",
  "conflicts": [],
  "requires": [],
  "env": [
    {
      "key": "RESEND_API_KEY",
      "description": "Resend API key",
      "required": true,
      "secret": true,
      "example": "re_xxx"
    },
    {
      "key": "RESEND_FROM_EMAIL",
      "description": "Default from email address",
      "required": true,
      "secret": false,
      "example": "noreply@yourdomain.com"
    }
  ],
  "postInstall": [
    "Get API key from https://resend.com",
    "Verify your domain",
    "Set environment variables"
  ],
  "version": "4.0.0",
  "targets": {
    "nestjs": {
      "files": [
        "src/modules/email"
      ],
      "inject": [
        {
          "file": "src/app.module.ts",
          "marker": "@obora:imports",
          "content": "import { EmailModule } from \"./modules/email/email.module.js\";"
        },
        {
          "file": "src/app.module.ts",
          "marker": "@obora:modules",
          "content": "EmailModule,"
        }
      ],
      "detect": {
        "packages": [
          "@nestjs/core"
        ],
        "packageVersions": {
          "@nestjs/core": ">=10"
        },
        "runtime": {
          "node": ">=18"
        }
      }
    }
  },
  "common": {
    "dependencies": {
      "resend": "^4.0.0",
      "@react-email/components": "^0.0.25",
      "react-email": "^3.0.0"
    }
  }
}
