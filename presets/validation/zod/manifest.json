{
  "$schema": "../../preset.schema.json",
  "name": "zod",
  "category": "validation",
  "description": "Zod - TypeScript-first schema validation with static type inference",
  "conflicts": [
    "effect-schema"
  ],
  "requires": [],
  "env": [],
  "postInstall": [],
  "version": "3.24.0",
  "targets": {
    "nextjs": {
      "files": [
        "nextjs"
      ],
      "detect": {
        "packages": [
          "next"
        ],
        "packageVersions": {
          "next": ">=14"
        }
      }
    },
    "nestjs": {
      "files": [
        "src/lib/validation"
      ],
      "detect": {
        "packages": [
          "@nestjs/core"
        ],
        "packageVersions": {
          "@nestjs/core": ">=10"
        },
        "runtime": {
          "node": ">=18"
        }
      }
    },
    "monorepo": {
      "description": "Shared validation package for monorepo (packages/validation)",
      "dependencies": {
        "zod": "^3.24.0"
      },
      "files": ["monorepo"],
      "packageJson": {
        "name": "@{{workspace}}/validation",
        "main": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "exports": {
          ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
          }
        },
        "scripts": {
          "build": "tsc",
          "dev": "tsc --watch"
        }
      },
      "detect": {
        "files": [
          "pnpm-workspace.yaml",
          "lerna.json",
          "nx.json"
        ]
      },
      "postInstall": [
        "Build package: pnpm build",
        "Import in apps: import { z, emailSchema, safeParse } from '@{{workspace}}/validation'"
      ]
    }
  },
  "common": {
    "dependencies": {
      "zod": "^3.24.0"
    }
  }
}
