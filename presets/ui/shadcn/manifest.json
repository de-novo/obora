{
  "$schema": "../../preset.schema.json",
  "name": "shadcn",
  "category": "ui",
  "description": "shadcn/ui - Beautiful, accessible React components (init only)",
  "version": "2.1.0",
  "common": {
    "devDependencies": {
      "tailwindcss-animate": "^1.0.7",
      "class-variance-authority": "^0.7.0",
      "clsx": "^2.1.0",
      "tailwind-merge": "^2.2.0"
    }
  },
  "targets": {
    "nextjs": {
      "description": "shadcn/ui for Next.js (Radix + Tailwind)",
      "detect": {
        "packages": ["next"],
        "packageVersions": {
          "next": ">=14.1"
        },
        "runtime": {
          "node": ">=18.12"
        }
      },
      "files": ["nextjs"]
    }
  },
  "postInstall": [
    "Run: npx shadcn@latest init",
    "Then add components: npx shadcn@latest add button card dialog ...",
    "See https://ui.shadcn.com/docs for component list."
  ]
}
