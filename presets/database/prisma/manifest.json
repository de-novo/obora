{
  "$schema": "../../preset.schema.json",
  "name": "prisma",
  "category": "database",
  "description": "Prisma ORM - Type-safe database client",
  "conflicts": [
    "drizzle"
  ],
  "requires": [],
  "env": [
    {
      "key": "DATABASE_URL",
      "description": "PostgreSQL connection string",
      "required": true,
      "secret": true,
      "example": "postgresql://postgres:postgres@localhost:5432/mydb"
    }
  ],
  "postInstall": [
    "Generate client: pnpm prisma generate",
    "Run migrations: pnpm prisma migrate dev"
  ],
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio"
  },
  "version": "7.0.0",
  "targets": {
    "nextjs": {
      "files": [
        "prisma",
        "prisma.config.ts",
        "nextjs"
      ],
      "detect": {
        "packages": [
          "next"
        ],
        "packageVersions": {
          "next": ">=14"
        }
      }
    },
    "nestjs": {
      "files": [
        "prisma",
        "prisma.config.ts",
        "src/db"
      ],
      "transform": [
        {
          "target": "src/app.module.ts",
          "type": "import",
          "content": "import { PrismaModule } from \"./db/prisma.module.js\";"
        },
        {
          "target": "src/app.module.ts",
          "type": "nestjs-module",
          "module": "PrismaModule"
        }
      ],
      "detect": {
        "packages": [
          "@nestjs/core"
        ],
        "packageVersions": {
          "@nestjs/core": ">=10"
        },
        "runtime": {
          "node": ">=18"
        }
      }
    },
    "standalone": {
      "description": "CLI tools, scripts, Lambda, and non-framework environments",
      "files": [
        "prisma",
        "prisma.config.ts",
        "standalone"
      ],
      "detect": {
        "excludes": [
          "next",
          "@nestjs/core"
        ]
      }
    },
    "monorepo": {
      "description": "Shared database package for monorepo (packages/database)",
      "files": [
        "prisma",
        "prisma.config.ts",
        "monorepo"
      ],
      "packageJson": {
        "name": "@{{workspace}}/database",
        "main": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "exports": {
          ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
          }
        },
        "scripts": {
          "build": "tsc",
          "db:generate": "prisma generate",
          "db:migrate": "prisma migrate dev",
          "db:push": "prisma db push"
        }
      },
      "detect": {
        "files": [
          "pnpm-workspace.yaml",
          "lerna.json",
          "nx.json"
        ]
      }
    }
  },
  "common": {
    "dependencies": {
      "@prisma/client": "^7.0.0",
      "@prisma/adapter-pg": "^7.0.0",
      "pg": "^8.13.0"
    },
    "devDependencies": {
      "prisma": "^7.0.0",
      "@types/pg": "^8.11.0"
    },
    "scripts": {
      "db:generate": "prisma generate",
      "db:migrate": "prisma migrate dev",
      "db:push": "prisma db push",
      "db:studio": "prisma studio"
    }
  }
}
