{
  "$schema": "../../preset.schema.json",
  "name": "prisma",
  "category": "database",
  "description": "Prisma ORM - Type-safe database client",
  "conflicts": [
    "drizzle"
  ],
  "requires": [],
  "env": [
    {
      "key": "DATABASE_URL",
      "description": "PostgreSQL connection string",
      "required": true,
      "secret": true,
      "example": "postgresql://postgres:postgres@localhost:5432/mydb"
    }
  ],
  "postInstall": [
    "Generate client: pnpm prisma generate",
    "Run migrations: pnpm prisma migrate dev"
  ],
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio"
  },
  "version": "7.0.0",
  "targets": {
    "nestjs": {
      "files": [
        "prisma",
        "prisma.config.ts",
        "src/db"
      ],
      "inject": [
        {
          "file": "src/app.module.ts",
          "marker": "@obora:imports",
          "content": "import { PrismaModule } from \"./db/prisma.module.js\";"
        },
        {
          "file": "src/app.module.ts",
          "marker": "@obora:modules",
          "content": "PrismaModule,"
        }
      ],
      "detect": {
        "packages": [
          "@nestjs/core"
        ],
        "packageVersions": {
          "@nestjs/core": ">=10"
        },
        "runtime": {
          "node": ">=18"
        }
      }
    }
  },
  "common": {
    "dependencies": {
      "@prisma/adapter-pg": "^7.0.0",
      "pg": "^8.13.0"
    },
    "devDependencies": {
      "prisma": "^7.0.0",
      "@types/pg": "^8.11.0"
    },
    "scripts": {
      "db:generate": "prisma generate",
      "db:migrate": "prisma migrate dev",
      "db:push": "prisma db push",
      "db:studio": "prisma studio"
    }
  }
}
