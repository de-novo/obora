{
  "$schema": "../../preset.schema.json",
  "name": "drizzle",
  "category": "database",
  "description": "Drizzle ORM - Type-safe SQL",
  "version": "0.45.0",
  "common": {
    "devDependencies": {
      "drizzle-kit": "^0.31.0"
    },
    "scripts": {
      "db:generate": "drizzle-kit generate",
      "db:push": "drizzle-kit push",
      "db:studio": "drizzle-kit studio"
    },
    "dependencies": {
      "drizzle-orm": "^0.45.0",
      "@neondatabase/serverless": "^0.10.0",
      "@paralleldrive/cuid2": "^2.2.0"
    }
  },
  "targets": {
    "sqlite": {
      "description": "SQLite with better-sqlite3 (Next.js, standalone)",
      "dialect": "sqlite",
      "dependencies": {
        "drizzle-orm": "^0.45.0",
        "better-sqlite3": "^11.0.0"
      },
      "devDependencies": {
        "@types/better-sqlite3": "^7.6.11"
      },
      "files": [
        "sqlite"
      ],
      "env": [
        {
          "key": "DATABASE_URL",
          "description": "SQLite database path",
          "required": false,
          "example": "file:./db.sqlite"
        }
      ],
      "detect": [
        "better-sqlite3",
        "sqlite3"
      ]
    },
    "postgres": {
      "description": "PostgreSQL with Neon serverless (NestJS, production)",
      "dialect": "postgresql",
      "dependencies": {
        "drizzle-orm": "^0.45.0",
        "@neondatabase/serverless": "^0.10.0"
      },
      "files": [
        "postgres"
      ],
      "env": [
        {
          "key": "DATABASE_URL",
          "description": "PostgreSQL connection string",
          "required": true,
          "secret": true,
          "example": "postgres://user:pass@host:5432/dbname"
        }
      ],
      "detect": [
        "pg",
        "@neondatabase/serverless"
      ]
    }
  },
  "conflicts": [
    "prisma"
  ],
  "postInstall": [
    "Define your schema",
    "Run: pnpm db:push"
  ]
}
