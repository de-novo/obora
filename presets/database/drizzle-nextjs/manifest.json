{
  "$schema": "../../preset.schema.json",
  "name": "drizzle-nextjs",
  "category": "database",
  "description": "Drizzle ORM for Next.js - Type-safe SQLite/PostgreSQL queries",
  "operations": {
    "replace": [],
    "merge": ["package.json"],
    "add": [
      "lib/db.ts",
      "lib/schema.ts",
      "drizzle.config.ts"
    ],
    "remove": [],
    "inject": []
  },
  "conflicts": ["prisma-nextjs"],
  "requires": [],
  "targetApps": ["nextjs-web"],
  "env": [
    {
      "key": "DATABASE_URL",
      "description": "Database connection string (SQLite: file:./db.sqlite, PostgreSQL: postgres://...)",
      "required": false,
      "secret": false,
      "example": "file:./db.sqlite"
    }
  ],
  "postInstall": [
    "Create your schema in lib/schema.ts",
    "Generate migrations: pnpm db:generate",
    "Run migrations: pnpm db:push"
  ],
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  }
}
