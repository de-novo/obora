{
  "$schema": "../../preset.schema.json",
  "name": "paddle",
  "category": "payment",
  "description": "Paddle - Merchant of Record for global SaaS",
  "conflicts": [
    "polar"
  ],
  "requires": [],
  "env": [
    {
      "key": "PADDLE_API_KEY",
      "description": "Paddle API key from dashboard",
      "required": true,
      "secret": true,
      "example": "your-paddle-api-key"
    },
    {
      "key": "PADDLE_WEBHOOK_SECRET",
      "description": "Paddle webhook signing secret",
      "required": true,
      "secret": true,
      "example": "pdl_ntfset_xxx"
    },
    {
      "key": "PADDLE_ENVIRONMENT",
      "description": "Paddle environment (sandbox or production)",
      "required": true,
      "secret": false,
      "example": "sandbox"
    }
  ],
  "postInstall": [
    "Set up Paddle dashboard: https://paddle.com",
    "Configure webhook endpoint",
    "Set environment variables"
  ],
  "version": "1.0.0",
  "targets": {
    "nestjs": {
      "files": [
        "src/modules/payment"
      ],
      "transform": [
        {
          "target": "src/app.module.ts",
          "type": "import",
          "content": "import { PaymentModule } from \"./modules/payment/payment.module.js\";"
        },
        {
          "target": "src/app.module.ts",
          "type": "nestjs-module",
          "module": "PaymentModule"
        }
      ],
      "detect": {
        "packages": [
          "@nestjs/core"
        ],
        "packageVersions": {
          "@nestjs/core": ">=10"
        },
        "runtime": {
          "node": ">=18"
        }
      }
    }
  },
  "common": {
    "dependencies": {
      "@paddle/paddle-node-sdk": "^1.6.0"
    }
  }
}
