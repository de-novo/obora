{
  "$schema": "../../preset.schema.json",
  "name": "playwright",
  "category": "testing",
  "description": "Playwright - End-to-end testing framework",
  "version": "1.50.0",
  "common": {
    "devDependencies": {
      "@playwright/test": "^1.50.0"
    },
    "scripts": {
      "test:e2e": "playwright test",
      "test:e2e:ui": "playwright test --ui",
      "test:e2e:debug": "playwright test --debug"
    }
  },
  "targets": {
    "nextjs": {
      "description": "Next.js (E2E testing)",
      "files": ["nextjs"],
      "detect": {
        "packages": ["next"],
        "packageVersions": {
          "next": ">=14.1"
        }
      },
      "postInstall": [
        "Install browsers: pnpx playwright install",
        "Create E2E tests in e2e/ directory",
        "Run: pnpm test:e2e"
      ]
    }
  },
  "conflicts": ["cypress"],
  "postInstall": []
}
