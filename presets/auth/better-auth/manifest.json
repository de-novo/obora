{
  "$schema": "../../preset.schema.json",
  "name": "better-auth",
  "category": "auth",
  "description": "Better Auth - Self-hosted authentication library",
  "version": "1.4.0",
  "common": {
    "dependencies": {
      "better-auth": "^1.4.0"
    }
  },
  "requires": ["database:prisma"],
  "targets": {
    "nestjs": {
      "description": "Better Auth server for NestJS API (requires Prisma)",
      "dependencies": {
        "fastify": "^5.0.0"
      },
      "files": ["nestjs"],
      "transform": [
        {
          "target": "src/app.module.ts",
          "type": "import",
          "content": "import { AuthModule } from \"./modules/auth/auth.module.js\";"
        },
        {
          "target": "src/app.module.ts",
          "type": "nestjs-module",
          "module": "AuthModule"
        }
      ],
      "env": [
        {
          "key": "BETTER_AUTH_SECRET",
          "description": "Secret key for signing tokens (min 32 chars)",
          "required": true,
          "secret": true,
          "example": "your-super-secret-key-at-least-32-characters"
        },
        {
          "key": "BETTER_AUTH_URL",
          "description": "Base URL of the auth server",
          "required": true,
          "secret": false,
          "example": "http://localhost:3001"
        },
        {
          "key": "WEB_URL",
          "description": "Frontend URL for CORS configuration",
          "required": false,
          "secret": false,
          "example": "http://localhost:3000"
        }
      ]
    },
    "nextjs": {
      "description": "Better Auth client for Next.js with middleware",
      "files": ["nextjs"],
      "env": [
        {
          "key": "NEXT_PUBLIC_BETTER_AUTH_URL",
          "description": "Better Auth server URL (API backend)",
          "required": true,
          "secret": false,
          "example": "http://localhost:3001"
        }
      ],
      "detect": {
        "packages": ["next"],
        "packageVersions": {
          "next": ">=14"
        },
        "runtime": {
          "node": ">=18"
        }
      }
    },
    "monorepo": {
      "description": "Shared auth utilities package for monorepo (packages/auth)",
      "dependencies": {
        "better-auth": "^1.4.0"
      },
      "files": ["monorepo"],
      "packageJson": {
        "name": "@{{workspace}}/auth",
        "main": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "exports": {
          ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
          }
        },
        "scripts": {
          "build": "tsc",
          "dev": "tsc --watch"
        }
      },
      "detect": {
        "files": ["pnpm-workspace.yaml", "lerna.json", "nx.json"]
      },
      "postInstall": [
        "Build package: pnpm build",
        "Import in apps: import { Session, createAuthConfig } from '@{{workspace}}/auth'"
      ]
    }
  },
  "conflicts": ["clerk"],
  "postInstall": [
    "Generate secret: openssl rand -base64 32",
    "Configure social providers in auth config"
  ]
}
