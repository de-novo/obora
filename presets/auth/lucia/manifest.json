{
  "$schema": "../../preset.schema.json",
  "name": "lucia",
  "category": "auth",
  "description": "Lucia - Auth library for your TypeScript projects",
  "version": "3.2.0",
  "common": {
    "dependencies": {
      "lucia": "^3.2.0",
      "@lucia-auth/adapter-drizzle": "^1.1.0"
    }
  },
  "targets": {
    "nextjs": {
      "description": "Next.js App Router with Lucia auth",
      "dependencies": {
        "lucia": "^3.2.0",
        "@lucia-auth/adapter-drizzle": "^1.1.0",
        "arctic": "^2.0.0"
      },
      "files": [
        "nextjs"
      ],
      "postInstall": [
        "Set up your database adapter in lib/auth/lucia.ts",
        "Add your OAuth providers in lib/auth/oauth.ts",
        "Configure session middleware in middleware.ts"
      ],
      "detect": [
        "next"
      ]
    },
    "standalone": {
      "description": "Standalone Lucia auth for any Node.js backend",
      "dependencies": {
        "lucia": "^3.2.0",
        "@lucia-auth/adapter-drizzle": "^1.1.0"
      },
      "files": [
        "standalone"
      ],
      "detect": {
        "excludes": [
          "next",
          "@nestjs/core"
        ]
      }
    },
    "monorepo": {
      "description": "Shared Lucia auth package for monorepo (packages/auth)",
      "dependencies": {
        "lucia": "^3.2.0",
        "@lucia-auth/adapter-drizzle": "^1.1.0"
      },
      "files": [
        "monorepo"
      ],
      "packageJson": {
        "name": "@{{workspace}}/auth",
        "main": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "exports": {
          ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
          }
        },
        "scripts": {
          "build": "tsc"
        }
      },
      "detect": {
        "files": [
          "pnpm-workspace.yaml",
          "lerna.json",
          "nx.json"
        ]
      }
    }
  }
}
