{
  "$schema": "../../preset.schema.json",
  "name": "tanstack-query",
  "category": "data-fetching",
  "description": "TanStack Query - Async state & data fetching for React",
  "version": "5.0.0",
  "common": {
    "dependencies": {
      "@tanstack/react-query": "^5.0.0"
    }
  },
  "targets": {
    "nextjs": {
      "description": "Next.js (manual provider setup)",
      "files": ["nextjs"],
      "detect": {
        "packages": ["next"],
        "packageVersions": {
          "next": ">=14.1"
        },
        "runtime": {
          "node": ">=18.12"
        }
      },
      "postInstall": [
        "See lib/query-prefetch.ts for SSR/prefetch example.",
        "Wrap your app with <QueryProvider /> in app/layout.tsx (client component)."
      ]
    },
    "nextjs-auto": {
      "description": "Next.js (auto layout injection)",
      "files": ["nextjs"],
      "transform": [
        {
          "target": "app/providers.tsx",
          "type": "import",
          "content": "import { QueryProvider } from \"@/lib/query\";"
        },
        {
          "target": "app/providers.tsx",
          "type": "provider-wrap",
          "provider": "QueryProvider"
        }
      ],
      "postInstall": [
        "See lib/query-prefetch.ts for SSR/prefetch example."
      ]
    },
    "nextjs-devtools": {
      "description": "Next.js (auto layout + ReactQueryDevtools)",
      "dependencies": {
        "@tanstack/react-query-devtools": "^5.0.0"
      },
      "files": ["nextjs"],
      "transform": [
        {
          "target": "app/providers.tsx",
          "type": "import",
          "content": "import { QueryProvider } from \"@/lib/query\";"
        },
        {
          "target": "app/providers.tsx",
          "type": "import",
          "content": "import { ReactQueryDevtools } from \"@tanstack/react-query-devtools\";"
        },
        {
          "target": "app/providers.tsx",
          "type": "provider-wrap",
          "provider": "QueryProvider"
        }
      ],
      "postInstall": [
        "Add <ReactQueryDevtools /> inside QueryProvider",
        "See lib/query-prefetch.ts for SSR/prefetch example."
      ]
    },
    "monorepo": {
      "description": "Shared query package for monorepo (packages/query)",
      "files": ["monorepo"],
      "packageJson": {
        "name": "@{{workspace}}/query",
        "main": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "exports": {
          ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
          }
        },
        "scripts": {
          "build": "tsc",
          "dev": "tsc --watch"
        }
      },
      "detect": {
        "files": [
          "pnpm-workspace.yaml",
          "lerna.json",
          "nx.json"
        ]
      },
      "postInstall": [
        "Build package: pnpm build",
        "Import in apps: import { QueryProvider, useQuery } from '@{{workspace}}/query'"
      ]
    }
  },
  "postInstall": []
}
