{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Obora Preset Manifest",
  "description": "Schema for obora preset manifest files (current)",
  "type": "object",
  "required": ["name", "category", "description"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Reference to this schema file"
    },
    "name": {
      "type": "string",
      "description": "Unique identifier for the preset"
    },
    "category": {
      "type": "string",
      "enum": [
        "linting",
        "database",
        "auth",
        "payment",
        "analytics",
        "data-fetching",
        "state",
        "i18n",
        "theming",
        "ui",
        "email",
        "ai",
        "storage",
        "validation"
      ],
      "description": "Category this preset belongs to"
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of the preset"
    },
    "version": {
      "type": "string",
      "description": "Preset version"
    },
    "common": {
      "type": "object",
      "description": "Shared configuration applied to all variants",
      "properties": {
        "dependencies": { "type": "object" },
        "devDependencies": { "type": "object" },
        "files": { "type": "array", "items": { "type": "string" } },
        "remove": { "type": "array", "items": { "type": "string" } },
        "scripts": { "type": "object" },
        "env": { "type": "array" },
        "postInstall": { "type": "array", "items": { "type": "string" } }
      }
    },
    "targets": {
      "type": "object",
      "description": "Target-specific configurations",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": { "type": "string" },
          "detect": {
            "oneOf": [
              {
                "type": "array",
                "items": { "type": "string" },
                "description": "Package names to detect this target"
              },
              {
                "type": "object",
                "description": "Detection rules for target selection",
                "properties": {
                  "packages": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Required package names"
                  },
                  "packageVersions": {
                    "type": "object",
                    "additionalProperties": { "type": "string" },
                    "description": "Required package version ranges (major-based)"
                  },
                  "runtime": {
                    "type": "object",
                    "properties": {
                      "node": { "type": "string" },
                      "bun": { "type": "boolean" },
                      "deno": { "type": "boolean" },
                      "packageManager": {
                        "type": "string",
                        "enum": ["pnpm", "yarn", "npm", "bun"]
                      }
                    }
                  }
                }
              }
            ]
          },
          "dependencies": { "type": "object" },
          "devDependencies": { "type": "object" },
          "files": { "type": "array", "items": { "type": "string" } },
          "remove": { "type": "array", "items": { "type": "string" } },
          "scripts": { "type": "object" },
          "inject": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["file", "marker", "content"],
              "properties": {
                "file": { "type": "string" },
                "marker": { "type": "string" },
                "content": { "type": "string" },
                "order": {
                  "type": "number",
                  "description": "Lower numbers are applied first within the same marker"
                }
              }
            }
          },
          "env": { "type": "array" },
          "postInstall": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "variants": {
      "type": "object",
      "description": "Framework-specific configurations",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "detect": {
            "oneOf": [
              {
                "type": "array",
                "items": { "type": "string" },
                "description": "Package names to detect this framework"
              },
              {
                "type": "object",
                "description": "Detection rules for target selection",
                "properties": {
                  "packages": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "packageVersions": {
                    "type": "object",
                    "additionalProperties": { "type": "string" }
                  },
                  "runtime": {
                    "type": "object",
                    "properties": {
                      "node": { "type": "string" },
                      "bun": { "type": "boolean" },
                      "deno": { "type": "boolean" },
                      "packageManager": {
                        "type": "string",
                        "enum": ["pnpm", "yarn", "npm", "bun"]
                      }
                    }
                  }
                }
              }
            ]
          },
          "description": { "type": "string" },
          "dependencies": { "type": "object" },
          "devDependencies": { "type": "object" },
          "files": { "type": "array", "items": { "type": "string" } },
          "remove": { "type": "array", "items": { "type": "string" } },
          "scripts": { "type": "object" },
          "inject": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["file", "marker", "content"],
              "properties": {
                "file": { "type": "string" },
                "marker": { "type": "string" },
                "content": { "type": "string" },
                "order": {
                  "type": "number",
                  "description": "Lower numbers are applied first within the same marker"
                }
              }
            }
          },
          "env": { "type": "array" },
          "postInstall": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Other preset names that conflict with this one"
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Capabilities provided by this preset"
    },
    "requiresCapabilities": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Capabilities required by this preset"
    },
    "incompatibleCapabilities": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Capabilities that conflict with this preset"
    },
    "requires": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Required presets in category:name format (e.g., database:prisma)"
    },
    "env": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key"],
        "properties": {
          "key": {
            "type": "string",
            "description": "Environment variable name"
          },
          "description": {
            "type": "string",
            "description": "Description of the variable"
          },
          "required": {
            "type": "boolean",
            "description": "Whether the variable is required"
          },
          "secret": {
            "type": "boolean",
            "description": "Whether the variable contains sensitive data"
          },
          "example": {
            "type": "string",
            "description": "Example value"
          }
        }
      },
      "description": "Environment variables required by this preset"
    },
    "scripts": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "NPM scripts to add to package.json"
    },
    "postInstall": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Post-install instructions to display"
    }
  }
}
