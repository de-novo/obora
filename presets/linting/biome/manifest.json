{
  "$schema": "../../preset.schema.json",
  "name": "biome",
  "category": "linting",
  "description": "Biome - Fast all-in-one linter & formatter (Rust-based)",
  "conflicts": [
    "eslint-prettier"
  ],
  "requires": [],
  "env": [],
  "postInstall": [],
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "version": "1.9.0",
  "targets": {
    "root": {
      "files": [
        "biome.json"
      ],
      "remove": [
        "eslint.config.js",
        ".eslintrc.js",
        ".eslintrc.json",
        ".prettierrc",
        ".prettierrc.json",
        ".prettierignore"
      ]
    }
  },
  "common": {
    "devDependencies": {
      "@biomejs/biome": "^1.9.0"
    },
    "scripts": {
      "lint": "biome check .",
      "lint:fix": "biome check --write .",
      "format": "biome format --write ."
    }
  }
}
