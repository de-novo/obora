{
  "$schema": "../../preset.schema.json",
  "name": "zustand",
  "category": "state",
  "description": "Zustand - Lightweight state management",
  "version": "5.0.0",
  "common": {
    "dependencies": {
      "zustand": "^5.0.0"
    }
  },
  "targets": {
    "nextjs": {
      "description": "Next.js (client-side state)",
      "files": ["nextjs"],
      "detect": {
        "packages": ["next"],
        "packageVersions": {
          "next": ">=14.1"
        }
      },
      "postInstall": [
        "See lib/store/example.ts for store example",
        "Import and use stores in your components"
      ]
    },
    "nextjs-persist": {
      "description": "Next.js with persistence middleware",
      "dependencies": {
        "zustand": "^5.0.0"
      },
      "files": ["nextjs"],
      "postInstall": [
        "See lib/store/example.ts for store with persistence",
        "Data persists in localStorage"
      ]
    },
    "monorepo": {
      "description": "Shared state package for monorepo (packages/state)",
      "dependencies": {
        "zustand": "^5.0.0"
      },
      "files": ["monorepo"],
      "packageJson": {
        "name": "@{{workspace}}/state",
        "main": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "exports": {
          ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
          }
        },
        "scripts": {
          "build": "tsc",
          "dev": "tsc --watch"
        }
      },
      "detect": {
        "files": [
          "pnpm-workspace.yaml",
          "lerna.json",
          "nx.json"
        ]
      },
      "postInstall": [
        "Build package: pnpm build",
        "Import in apps: import { createStore } from '@{{workspace}}/state'"
      ]
    }
  },
  "postInstall": []
}
