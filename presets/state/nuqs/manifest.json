{
  "$schema": "../../preset.schema.json",
  "name": "nuqs",
  "category": "state",
  "description": "nuqs - URL query state for React/Next.js",
  "version": "1.17.0",
  "common": {
    "dependencies": {
      "nuqs": "^1.17.0"
    }
  },
  "targets": {
    "nextjs": {
      "description": "Next.js (manual adapter setup)",
      "files": ["nextjs"],
      "detect": {
        "packages": ["next"],
        "packageVersions": {
          "next": ">=14.1"
        },
        "runtime": {
          "node": ">=18.12"
        }
      },
      "postInstall": [
        "Wrap your app with <NuqsAdapter> in app/layout.tsx or app/providers.tsx."
      ]
    },
    "nextjs-auto": {
      "description": "Next.js (auto adapter injection)",
      "files": ["nextjs"],
      "transform": [
        {
          "target": "app/providers.tsx",
          "type": "import",
          "content": "import { NuqsAdapter } from \"nuqs/adapters/next/app\";"
        },
        {
          "target": "app/providers.tsx",
          "type": "provider-wrap",
          "provider": "NuqsAdapter"
        }
      ]
    }
  },
  "postInstall": []
}
