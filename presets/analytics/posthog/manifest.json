{
  "$schema": "../../preset.schema.json",
  "name": "posthog",
  "category": "analytics",
  "description": "PostHog - Open source product analytics",
  "conflicts": [],
  "requires": [],
  "env": [
    {
      "key": "NEXT_PUBLIC_POSTHOG_KEY",
      "description": "PostHog project API key",
      "required": true,
      "secret": false,
      "example": "phc_xxx"
    },
    {
      "key": "NEXT_PUBLIC_POSTHOG_HOST",
      "description": "PostHog host URL",
      "required": true,
      "secret": false,
      "example": "https://us.i.posthog.com"
    }
  ],
  "postInstall": [
    "Set up PostHog account: https://posthog.com",
    "Get project API key from settings"
  ],
  "version": "1.200.0",
  "targets": {
    "nextjs": {
      "description": "Next.js (manual provider setup)",
      "files": [
        "src/lib/posthog"
      ],
      "detect": {
        "packages": [
          "next"
        ],
        "packageVersions": {
          "next": ">=14"
        },
        "runtime": {
          "node": ">=18"
        }
      }
    },
    "nextjs-auto": {
      "description": "Next.js (auto provider injection)",
      "files": [
        "src/lib/posthog"
      ],
      "transform": [
        {
          "target": "app/providers.tsx",
          "type": "import",
          "content": "import { PostHogProvider } from \"@/lib/posthog\";"
        },
        {
          "target": "app/providers.tsx",
          "type": "provider-wrap",
          "provider": "PostHogProvider"
        }
      ],
      "detect": {
        "packages": [
          "next"
        ],
        "packageVersions": {
          "next": ">=14"
        },
        "runtime": {
          "node": ">=18"
        }
      }
    }
  },
  "common": {
    "dependencies": {
      "posthog-js": "^1.200.0",
      "posthog-node": "^4.4.0"
    }
  }
}
