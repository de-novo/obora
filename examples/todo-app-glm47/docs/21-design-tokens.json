        "default": {
          "backgroundColor": "--color-bg",
          "borderColor": "--color-gray-200",
          "color": "--color-gray-700",
          "radius": "--radius-md",
          "padding": "8px 16px"
        },
        "active": {
          "backgroundColor": "--color-primary",
          "borderColor": "--color-primary",
          "color": "--color-bg"
        },
        "hover": {
          "backgroundColor": "--color-gray-50",
          "borderColor": "--color-gray-300"
        },
        "focus": {
          "borderColor": "--color-primary"
        }
      },
      "checkbox": {
        "default": {
          "size": "20px",
          "backgroundColor": "--color-bg",
          "borderColor": "--color-gray-400",
          "radius": "--radius-sm"
        },
        "checked": {
          "backgroundColor": "--color-primary",
          "borderColor": "--color-primary",
          "checkColor": "--color-bg"
        },
        "hover": {
          "borderColor": "--color-gray-500"
        },
        "focus": {
          "borderColor": "--color-primary"
        }
      },
      "todoItem": {
        "default": {
          "backgroundColor": "--color-bg",
          "radius": "--radius-md",
          "padding": "12px 16px"
        },
        "hover": {
          "backgroundColor": "--color-gray-50"
        },
        "completed": {
          "textColor": "--color-gray-400"
        },
        "focus": {
          "border": "1px solid --color-primary"
        }
      },
      "errorBanner": {
        "backgroundColor": "--color-error-bg",
        "borderColor": "--color-error-border",
        "color": "--color-error",
        "radius": "--radius-md",
        "padding": "12px 16px",
        "iconSize": "16px",
        "shadow": "--shadow-sm"
      },
      "emptyState": {
        "backgroundColor": "transparent",
        "textColor": "--color-gray-500",
        "padding": "32px 16px",
        "iconSize": "48px",
        "iconColor": "--color-gray-300",
        "textSize": "--font-size-lg",
        "textWeight": "--font-weight-medium"
      }
    }
  },
  "accessibility": {
    "focus": {
      "outline": "2px solid var(--color-primary)",
      "outlineOffset": "2px"
    },
    "contrast": {
      "textOnPrimary": {
        "foreground": "#FFFFFF",
        "background": "#4F46E5",
        "ratio": 5.8,
        "wcag": "AA"
      },
      "textOnDefault": {
        "foreground": "#111827",
        "background": "#FFFFFF",
        "ratio": 15.8,
        "wcag": "AA"
      },
      "textOnError": {
        "foreground": "#DC2626",
        "background": "#FEF2F2",
        "ratio": 5.3,
        "wcag": "AA"
      },
      "placeholder": {
        "foreground": "#9CA3AF",
        "background": "#F3F4F6",
        "ratio": 4.6,
        "wcag": "AA"
      }
    },
    "touchTarget": {
      "minimum": "44x44px"
    }
  },
  "theme": {
    "light": {
      "name": "Light Theme",
      "default": true
    },
    "dark": {
      "name": "Dark Theme",
      "default": false,
      "overrides": {
        "--color-bg": "#111827",
        "--color-bg-alt": "#1F2937",
        "--color-text": "#F9FAFB",
        "--color-text-muted": "#9CA3AF"
      }
    }
  }
}
