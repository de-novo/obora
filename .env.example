# Obora Development Environment
# Copy this file to .env and modify as needed

# Development mode - uses local CLI build instead of global obora command
# Set to "true" when developing obora-kit itself
OBORA_DEV=false

# ── E2E Test Environment ──
# These variables configure the E2E test suite (pnpm test:e2e).
# Unit tests (pnpm test) use MockLLMAdapter and need no API keys.
#
# Required for E2E:
# ZAI_API_KEY=your-zai-api-key
#
# Optional overrides:
# OBORA_TEST_PROVIDER=zai           # LLM provider (default: zai)
# OBORA_TEST_MODEL=glm-4.7          # Model to use (default: glm-4.7)
# OBORA_TEST_BASE_URL=              # Custom base URL (optional)
