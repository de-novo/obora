{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "baseUrl": ".",
    "paths": {
      "@obora/adapters": ["packages/adapters/src/typecheck-public.d.ts"],
      "@obora/adapters/llm": ["packages/adapters/src/typecheck-public.d.ts"],
      "@obora/adapters/tools": ["packages/adapters/src/typecheck-public.d.ts"],
      "@obora/adapters/auth": ["packages/adapters/src/typecheck-public.d.ts"],
      "@obora/runtime": ["packages/runtime/src/typecheck-public.d.ts"],
      "@obora/sdk": ["packages/sdk/src/index.ts"],
      "@obora/dashboard": ["packages/dashboard/src/index.ts"]
    },
    "sourceMap": true
  }
}
