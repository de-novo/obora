{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cd \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\" && [ -x ./.claude/scripts/obora/logging/log-session-start.sh ] && ./.claude/scripts/obora/logging/log-session-start.sh || true'"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cd \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\" && [ -x ./.claude/scripts/obora/logging/log-session-end.sh ] && ./.claude/scripts/obora/logging/log-session-end.sh || true'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cd \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\" && [ -x ./.claude/scripts/obora/logging/log-prompt-submit.sh ] && ./.claude/scripts/obora/logging/log-prompt-submit.sh || true'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cd \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\" && [ -x ./.claude/scripts/obora/logging/log-prompt-complete.sh ] && ./.claude/scripts/obora/logging/log-prompt-complete.sh || true'"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cd \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\" && [ -x ./.claude/scripts/obora/logging/log-agent-start.sh ] && ./.claude/scripts/obora/logging/log-agent-start.sh || true'"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cd \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\" && [ -x ./.claude/scripts/obora/logging/log-agent-stop.sh ] && ./.claude/scripts/obora/logging/log-agent-stop.sh || true'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cd \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\" && [ -x ./.claude/scripts/obora/logging/log-tool-use.sh ] && ./.claude/scripts/obora/logging/log-tool-use.sh || true'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cd \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\" && [ -x ./.claude/scripts/obora/logging/log-tool-use.sh ] && ./.claude/scripts/obora/logging/log-tool-use.sh || true'"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [],
    "deny": []
  }
}
