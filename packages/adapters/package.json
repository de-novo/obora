{
  "name": "@obora-kit/adapters",
  "version": "0.1.0",
  "description": "External integration adapters",
  "type": "module",
  "keywords": [
    "ai",
    "adapters",
    "integration",
    "llm",
    "tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obora-labs/obora-kit.git"
  },
  "bugs": {
    "url": "https://github.com/obora-labs/obora-kit/issues"
  },
  "homepage": "https://github.com/obora-labs/obora-kit#readme",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./llm": {
      "import": {
        "types": "./dist/llm/index.d.ts",
        "default": "./dist/llm/index.js"
      },
      "require": {
        "types": "./dist/llm/index.d.cts",
        "default": "./dist/llm/index.cjs"
      }
    },
    "./tools": {
      "import": {
        "types": "./dist/tools/index.d.ts",
        "default": "./dist/tools/index.js"
      },
      "require": {
        "types": "./dist/tools/index.d.cts",
        "default": "./dist/tools/index.cjs"
      }
    },
    "./auth": {
      "import": {
        "types": "./dist/auth/index.d.ts",
        "default": "./dist/auth/index.js"
      },
      "require": {
        "types": "./dist/auth/index.d.cts",
        "default": "./dist/auth/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@mariozechner/pi-ai": "^0.52.12",
    "@mariozechner/pi-agent-core": "^0.52.12",
    "yaml": "^2.8.2"
  }
}
