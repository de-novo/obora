{
  "name": "@obora/project-config",
  "version": "0.1.0",
  "description": "Project and global configuration management for obora-kit",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "pathe": "^1.1.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "@obora/project-templates": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@obora/project-templates": {
      "optional": true
    }
  }
