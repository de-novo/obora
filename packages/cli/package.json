{
  "name": "@obora/cli",
  "version": "0.1.2",
  "description": "Obora CLI \u2014 command-line interface for AI Control Runtime",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "obora": "bin/obora.js"
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc --noCheck",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@obora/sdk": "0.1.1",
    "@obora/adapters": "0.1.1",
    "@obora/runtime": "0.1.1",
    "commander": "^14.0.3",
    "fs-extra": "^11.3.3",
    "open": "^10.2.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "chalk": "^5.6.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "keywords": [
    "ai",
    "runtime",
    "control",
    "orchestration",
    "policy",
    "audit",
    "multi-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/de-novo/obora.git"
  },
  "bugs": {
    "url": "https://github.com/de-novo/obora/issues"
  },
  "homepage": "https://github.com/de-novo/obora#readme",
  "license": "MIT",
  "files": [
    "dist",
    "bin",
    "!dist/**/__tests__/**",
    "!dist/**/*.test.*",
    "!dist/**/*-e2e.test.*",
    "README.md",
    "LICENSE",
    "templates"
  ],
  "engines": {
    "node": ">=18"
  }
}
