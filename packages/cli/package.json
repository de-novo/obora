{
  "name": "@obora/cli",
  "version": "0.1.4",
  "description": "Obora CLI — command-line interface for AI Control Runtime",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "obora": "bin/obora.js"
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc --noCheck -p tsconfig.build.json",
    "lint": "eslint src --ext .ts --quiet",
    "clean": "rm -rf dist",
    "test": "node --no-warnings ./node_modules/vitest/vitest.mjs run",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test:coverage": "node --no-warnings ./node_modules/vitest/vitest.mjs --coverage"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "0.75.3",
    "@obora/adapters": "workspace:*",
    "@obora/runtime": "workspace:*",
    "@obora/sdk": "workspace:*",
    "commander": "^14.0.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@vitest/coverage-v8": "^4.1.6",
    "chalk": "^5.6.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "keywords": [
    "ai",
    "runtime",
    "control",
    "orchestration",
    "policy",
    "audit",
    "multi-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/de-novo/obora.git"
  },
  "bugs": {
    "url": "https://github.com/de-novo/obora/issues"
  },
  "homepage": "https://github.com/de-novo/obora#readme",
  "license": "MIT",
  "files": [
    "dist",
    "bin",
    "!dist/**/__tests__/**",
    "!dist/**/*.test.*",
    "!dist/**/*-e2e.test.*",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    "templates"
  ],
  "engines": {
    "node": ">=20"
  }
}
