{
  "name": "@obora/kit",
  "version": "0.1.0",
  "description": "CLI for scaffolding TypeScript SaaS projects with modular presets",
  "type": "module",
  "bin": {
    "obora": "./dist/obora.mjs"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "skills",
    "agents",
    "rules",
    "commands",
    "scripts",
    "settings.json"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "dev:stub": "unbuild --stub",
    "start": "node bin/obora.mjs",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.5",
    "@obora/agent-claude": "workspace:*",
    "@obora/database": "workspace:*",
    "@obora/preset-engine": "workspace:*",
    "@obora/project-config": "workspace:*",
    "@obora/project-templates": "workspace:*",
    "@obora/workflow-core": "workspace:*",
    "better-sqlite3": "^11.10.0",
    "citty": "^0.1.6",
    "consola": "^3.2.3",
    "defu": "^6.1.4",
    "giget": "^1.2.3",
    "jiti": "^2.4.0",
    "pathe": "^1.1.2",
    "pkg-types": "^1.2.1",
    "prompts": "^2.4.2",
    "socket.io-client": "^4.8.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.0.0",
    "@types/prompts": "^2.4.9",
    "@vitest/coverage-v8": "^2.1.0",
    "typescript": "^5.3.0",
    "unbuild": "^2.0.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "cli",
    "obora",
    "scaffold",
    "template",
    "nextjs",
    "nestjs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/obora-labs/obora-kit.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
