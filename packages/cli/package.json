{
  "name": "@obora/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Obora CLI tool",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "obora": "./bin/obora.js"
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@obora/core": "workspace:*",
    "@obora/dashboard": "workspace:*",
    "@obora/database": "workspace:*",
    "@obora-kit/agents": "workspace:*",
    "@obora-kit/blackboard": "workspace:*",
    "commander": "^14.0.3",
    "fs-extra": "^11.3.3",
    "open": "^10.2.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "chalk": "^5.6.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
