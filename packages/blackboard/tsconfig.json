{
  // 독립 설정 유지: tsconfig.base.json 파일이 존재하지 않음
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist",

    /* Module */
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",

    /* Type Checking */
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,

    /* Emit */
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    // composite: true is required for project references and tsc --noEmit.
    // tsup overrides this to false during DTS generation to avoid TS6307.
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",

    /* Paths */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}
