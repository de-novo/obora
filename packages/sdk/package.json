{
  "name": "@obora/sdk",
  "version": "0.1.4",
  "description": "Obora SDK — programmatic API for AI Control Runtime",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "require": "./dist/testing/index.cjs"
    }
  },
  "files": [
    "dist",
    "!dist/**/__tests__/**",
    "!dist/**/*.test.*",
    "!dist/**/*-e2e.test.*",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declaration --declarationMap false --outDir dist --noCheck",
    "dev": "tsup --watch",
    "lint": "eslint src --ext .ts --quiet",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@obora/runtime": "workspace:*",
    "yaml": "^2.8.4",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@obora/adapters": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "peerDependencies": {
    "@obora/runtime": "workspace:*",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "keywords": [
    "ai",
    "runtime",
    "control",
    "orchestration",
    "policy",
    "audit",
    "multi-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/de-novo/obora.git"
  },
  "bugs": {
    "url": "https://github.com/de-novo/obora/issues"
  },
  "homepage": "https://github.com/de-novo/obora#readme",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
