{
  "name": "@obora/sdk",
  "version": "0.1.0",
  "description": "Obora SDK — programmatic API for AI Control Runtime",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@obora/runtime": "workspace:*",
    "yaml": "^2.8.2"
  },
  "optionalDependencies": {
    "@obora/adapters": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0",
    "@obora/runtime": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "keywords": [
    "ai",
    "runtime",
    "control",
    "orchestration",
    "policy",
    "audit",
    "multi-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obora-labs/obora-kit.git"
  },
  "bugs": {
    "url": "https://github.com/obora-labs/obora-kit/issues"
  },
  "homepage": "https://github.com/obora-labs/obora-kit#readme",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
