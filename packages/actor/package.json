{
  "name": "@obora-kit/actor",
  "version": "0.1.0",
  "description": "Actor package for AI agent coordination and lifecycle management",
  "keywords": [
    "actor",
    "ai-agents",
    "lifecycle",
    "coordination",
    "obora-kit"
  ],
  "author": "obora-kit contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/obora-kit/obora-kit.git",
    "directory": "packages/actor"
  },
  "homepage": "https://github.com/obora-kit/obora-kit/tree/main/packages/actor",
  "bugs": {
    "url": "https://github.com/obora-kit/obora-kit/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/types/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/types/index.cjs"
      }
    },
    "./runtime": {
      "import": {
        "types": "./dist/runtime/index.d.ts",
        "default": "./dist/runtime/index.js"
      },
      "require": {
        "types": "./dist/runtime/index.d.cts",
        "default": "./dist/runtime/index.cjs"
      }
    },
    "./pool": {
      "import": {
        "types": "./dist/pool/index.d.ts",
        "default": "./dist/pool/index.js"
      },
      "require": {
        "types": "./dist/pool/index.d.cts",
        "default": "./dist/pool/index.cjs"
      }
    },
    "./supervision": {
      "import": {
        "types": "./dist/supervision/index.d.ts",
        "default": "./dist/supervision/index.js"
      },
      "require": {
        "types": "./dist/supervision/index.d.cts",
        "default": "./dist/supervision/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:types": "tsc --emitDeclarationOnly",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.23.0",
    "@typescript-eslint/parser": "^8.23.0",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^9.19.0",
    "rimraf": "^5.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.54.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "@obora-kit/blackboard": "workspace:*"
  },
  "peerDependencies": {
    "@obora-kit/blackboard": ">=0.0.1",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
