{
  "name": "@obora/dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Obora M4 dashboard web server scaffold",
  "type": "module",
  "keywords": [
    "dashboard",
    "monitoring",
    "ai",
    "runtime"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obora-labs/obora-kit.git"
  },
  "bugs": {
    "url": "https://github.com/obora-labs/obora-kit/issues"
  },
  "homepage": "https://github.com/obora-labs/obora-kit#readme",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server/types": {
      "types": "./dist/server/types.d.ts",
      "default": "./dist/server/types.js"
    }
  },
  "scripts": {
    "dev": "concurrently \"vite --config vite.config.ts\" \"tsx src/server/index.ts\"",
    "build": "vite build && tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.1.1",
    "@fastify/websocket": "^11.2.0",
    "@obora/runtime": "workspace:*",
    "fastify": "^5.6.0",
    "js-yaml": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^7.1.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
