{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noImplicitOverride": false
  },
  "include": ["src/**/*"],
  "exclude": [
    "dist",
    "node_modules",
    "test/**/*",
    "src/**/*.test.ts",
    "src/**/__tests__/**",
    "src/**/runtime-tests/**",
    "src/**/pool-tests/**",
    "src/**/base-tests/**",
    "src/_legacy/**"
  ]
}
