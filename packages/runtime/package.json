{
  "name": "@obora/runtime",
  "version": "0.1.2",
  "description": "AI Control Runtime - deterministic orchestration for non-deterministic AI",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "!dist/**/__tests__/**",
    "!dist/**/*.test.*",
    "!dist/**/*-e2e.test.*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declaration --declarationMap false --outDir dist --noCheck",
    "dev": "tsup --watch",
    "lint": "eslint src --ext .ts --quiet",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@mariozechner/pi-agent-core": "^0.65.0",
    "@mariozechner/pi-ai": "^0.65.0",
    "@obora/adapters": "workspace:*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "pako": "^2.1.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@obora/adapters": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/pako": "^2.0.4",
    "better-sqlite3": "^12.6.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "keywords": [
    "ai",
    "runtime",
    "control",
    "orchestration",
    "policy",
    "audit",
    "multi-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/de-novo/obora.git"
  },
  "bugs": {
    "url": "https://github.com/de-novo/obora/issues"
  },
  "homepage": "https://github.com/de-novo/obora#readme",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
